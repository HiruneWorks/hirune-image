{
  "components": {
    "schemas": {
      "AnimationPolicy": {
        "enum": [
          "preserve",
          "first_frame",
          "reject"
        ],
        "type": "string"
      },
      "Capabilities": {
        "properties": {
          "allow_upscale": {
            "type": "boolean"
          },
          "animation_policies": {
            "items": {
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "codec_limits": {
            "$ref": "#/components/schemas/CodecLimits"
          },
          "color_policy": {
            "type": "string"
          },
          "contract_version": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "encoding_modes": {
            "items": {
              "type": "string"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "input_formats": {
            "items": {
              "type": "string"
            },
            "maxItems": 4,
            "minItems": 4,
            "type": "array"
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          },
          "native_resource_fence": {
            "type": "string"
          },
          "output_format": {
            "type": "string"
          },
          "processor": {
            "$ref": "#/components/schemas/ProcessorInfo"
          },
          "resize_fit": {
            "type": "string"
          },
          "zero_delay_policy": {
            "type": "string"
          }
        },
        "required": [
          "contract_version",
          "processor",
          "limits",
          "codec_limits",
          "input_formats",
          "output_format",
          "encoding_modes",
          "animation_policies",
          "resize_fit",
          "allow_upscale",
          "zero_delay_policy",
          "color_policy",
          "native_resource_fence"
        ],
        "title": "Capabilities",
        "type": "object"
      },
      "CodecLimits": {
        "properties": {
          "cycle_duration_ms": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "frame_duration_ms": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "webp_dimension": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "webp_file_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "webp_dimension",
          "webp_file_bytes",
          "frame_duration_ms",
          "cycle_duration_ms"
        ],
        "type": "object"
      },
      "EncodingInput": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "effort": {
                "format": "uint8",
                "maximum": 6,
                "minimum": 0,
                "type": "integer"
              },
              "format": {
                "$ref": "#/components/schemas/OutputFormat"
              },
              "mode": {
                "const": "lossy",
                "type": "string"
              },
              "quality": {
                "format": "uint8",
                "maximum": 100,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "mode",
              "format",
              "quality",
              "effort"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "effort": {
                "format": "uint8",
                "maximum": 6,
                "minimum": 0,
                "type": "integer"
              },
              "format": {
                "$ref": "#/components/schemas/OutputFormat"
              },
              "mode": {
                "const": "lossless",
                "type": "string"
              }
            },
            "required": [
              "mode",
              "format",
              "effort"
            ],
            "type": "object"
          }
        ]
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDescription"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "ErrorDescription": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ProcessingError"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "type": "object"
      },
      "Limits": {
        "additionalProperties": false,
        "properties": {
          "canvas_pixels": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "child_cpu_seconds": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "child_memory_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "concurrency": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "deadline_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "decoded_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "duration_ms": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "frames": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "idle_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "input_dimension": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "output_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "output_dimension": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "outputs": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "recipe_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "request_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "source_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "spool_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "total_frame_pixels": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "working_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "source_bytes",
          "request_bytes",
          "recipe_bytes",
          "input_dimension",
          "canvas_pixels",
          "frames",
          "total_frame_pixels",
          "decoded_bytes",
          "working_bytes",
          "spool_bytes",
          "duration_ms",
          "outputs",
          "output_bytes",
          "output_dimension",
          "concurrency",
          "deadline_ms",
          "idle_ms",
          "child_memory_bytes",
          "child_cpu_seconds"
        ],
        "type": "object"
      },
      "Manifest": {
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "format": "uint32",
            "maximum": 1,
            "minimum": 1,
            "type": "integer"
          },
          "outputs": {
            "items": {
              "$ref": "#/components/schemas/OutputFacts"
            },
            "minItems": 1,
            "type": "array"
          },
          "processor": {
            "$ref": "#/components/schemas/ProcessorInfo"
          },
          "recipe_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/SourceFacts"
          },
          "source_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "contract_version",
          "processor",
          "source_sha256",
          "recipe_sha256",
          "source",
          "outputs"
        ],
        "title": "Manifest",
        "type": "object"
      },
      "MediaType": {
        "enum": [
          "image/webp"
        ],
        "type": "string"
      },
      "OutputFacts": {
        "properties": {
          "byte_size": {
            "format": "uint64",
            "maximum": 4294967294,
            "minimum": 12,
            "type": "integer"
          },
          "duration_ms": {
            "format": "uint32",
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer"
          },
          "frame_count": {
            "format": "uint32",
            "minimum": 1,
            "type": "integer"
          },
          "height": {
            "format": "uint32",
            "minimum": 1,
            "type": "integer"
          },
          "id": {
            "pattern": "^[a-z][a-z0-9_]{0,31}$",
            "type": "string"
          },
          "loop_count": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "media_type": {
            "$ref": "#/components/schemas/MediaType"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "width": {
            "format": "uint32",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "media_type",
          "byte_size",
          "sha256",
          "width",
          "height",
          "frame_count",
          "duration_ms",
          "loop_count"
        ],
        "type": "object"
      },
      "OutputFormat": {
        "enum": [
          "webp"
        ],
        "type": "string"
      },
      "OutputInput": {
        "additionalProperties": false,
        "properties": {
          "encoding": {
            "$ref": "#/components/schemas/EncodingInput"
          },
          "id": {
            "maxLength": 32,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]{0,31}$",
            "type": "string"
          },
          "resize": {
            "$ref": "#/components/schemas/ResizeInput"
          }
        },
        "required": [
          "id",
          "resize",
          "encoding"
        ],
        "type": "object"
      },
      "ProcessingError": {
        "enum": [
          "invalid_request",
          "invalid_recipe",
          "request_too_large",
          "image_limits_exceeded",
          "output_limits_exceeded",
          "unsupported_format",
          "invalid_image",
          "unsupported_color_profile",
          "animation_not_allowed",
          "unrepresentable_animation",
          "processor_overloaded",
          "processor_unavailable",
          "processing_timeout",
          "internal_error"
        ],
        "type": "string"
      },
      "ProcessorInfo": {
        "additionalProperties": false,
        "properties": {
          "build_id": {
            "type": "string"
          },
          "color_engine": {
            "type": "string"
          },
          "gif": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "libwebp_decoder": {
            "type": "string"
          },
          "libwebp_demux": {
            "type": "string"
          },
          "libwebp_encoder": {
            "type": "string"
          },
          "libwebp_mux": {
            "type": "string"
          },
          "pipeline_version": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "version",
          "build_id",
          "pipeline_version",
          "image",
          "gif",
          "libwebp_encoder",
          "libwebp_decoder",
          "libwebp_demux",
          "libwebp_mux",
          "color_engine"
        ],
        "type": "object"
      },
      "Recipe": {
        "additionalProperties": false,
        "properties": {
          "animation_policy": {
            "$ref": "#/components/schemas/AnimationPolicy"
          },
          "contract_version": {
            "format": "uint32",
            "maximum": 1,
            "minimum": 1,
            "type": "integer"
          },
          "outputs": {
            "items": {
              "$ref": "#/components/schemas/OutputInput"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "contract_version",
          "animation_policy",
          "outputs"
        ],
        "title": "RecipeInput",
        "type": "object"
      },
      "ResizeFit": {
        "enum": [
          "inside"
        ],
        "type": "string"
      },
      "ResizeInput": {
        "additionalProperties": false,
        "properties": {
          "fit": {
            "$ref": "#/components/schemas/ResizeFit"
          },
          "max_height": {
            "format": "uint32",
            "maximum": 16383,
            "minimum": 1,
            "type": "integer"
          },
          "max_width": {
            "format": "uint32",
            "maximum": 16383,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "fit",
          "max_width",
          "max_height"
        ],
        "type": "object"
      },
      "SourceFacts": {
        "properties": {
          "byte_size": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "duration_ms": {
            "format": "uint32",
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer"
          },
          "format": {
            "$ref": "#/components/schemas/SourceFormat"
          },
          "frame_count": {
            "format": "uint32",
            "minimum": 1,
            "type": "integer"
          },
          "height": {
            "format": "uint32",
            "minimum": 1,
            "type": "integer"
          },
          "loop_count": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "orientation": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "width": {
            "format": "uint32",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "format",
          "byte_size",
          "orientation",
          "width",
          "height",
          "frame_count",
          "duration_ms",
          "loop_count"
        ],
        "type": "object"
      },
      "SourceFormat": {
        "enum": [
          "jpeg",
          "png",
          "gif",
          "webp"
        ],
        "type": "string"
      }
    }
  },
  "info": {
    "title": "Hirune Image",
    "version": "0.2.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "responses": {
          "204": {
            "description": "The API process is running."
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "responses": {
          "204": {
            "description": "The service is ready."
          },
          "503": {
            "description": "The service is shutting down or unavailable."
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            },
            "description": "The response describes active limits, pipeline policy, and native codec versions."
          }
        }
      }
    },
    "/v1/images/process": {
      "post": {
        "operationId": "processImage",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "encoding": {
                "recipe": {
                  "contentType": "application/json"
                }
              },
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "format": "binary",
                    "type": "string"
                  },
                  "recipe": {
                    "$ref": "#/components/schemas/Recipe"
                  }
                },
                "required": [
                  "file",
                  "recipe"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "multipart/related": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The JSON manifest is the first part. WebP parts follow in recipe order. Each part has Content-ID and Content-Length. The service verifies every output before sending response headers."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The request or recipe is invalid."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The request exceeds a byte, pixel, frame, duration, or output limit."
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The image format is unsupported."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The image is invalid, or its color or animation is unsupported."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "An internal error occurs."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The processor is busy or unavailable. The response includes Retry-After: 1."
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A timeout occurs before response headers."
          }
        }
      }
    }
  }
}
