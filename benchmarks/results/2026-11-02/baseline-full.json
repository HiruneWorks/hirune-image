        "timing_policy": "nearest_cumulative_millisecond; reject_unrepresentable_frames",
        "color_policy": "icc_and_cicp_to_srgb8; unprofiled_srgb; reject_hdr",
        "native_resource_fence": "rlimit_as_and_cpu"
      },
      "environment": [
        "HIRUNE_CONCURRENCY=1",
        "HIRUNE_OUTPUTS=8"
      ]
    }
  ]
}
